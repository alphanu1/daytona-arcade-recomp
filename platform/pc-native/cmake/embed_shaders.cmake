# cmake -DOUT=pc_shaders.inc -DINPUTS="a.spv;b.spv" -P embed_shaders.cmake
# Writes kEmbeddedShaders[] for backend/pc_endjinn_vulkan.cpp's read_shader_file.
set(body "")
set(table "")
set(index 0)
foreach(path IN LISTS INPUTS)
  get_filename_component(name "${path}" NAME)
  file(READ "${path}" hex HEX)
  string(LENGTH "${hex}" hexlen)
  math(EXPR size "${hexlen} / 2")
  string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
  string(APPEND body "static const unsigned char kShader${index}[] = {${bytes}};\n")
  string(APPEND table "    {\"${name}\", kShader${index}, ${size}u},\n")
  math(EXPR index "${index} + 1")
endforeach()
file(WRITE "${OUT}.tmp" "/* Generated by embed_shaders.cmake. */\n${body}const EmbeddedShader kEmbeddedShaders[] = {\n${table}};\n")
file(COPY_FILE "${OUT}.tmp" "${OUT}" ONLY_IF_DIFFERENT)
file(REMOVE "${OUT}.tmp")
