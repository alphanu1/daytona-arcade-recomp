+void i960_cpu_device::device_stop()
+{
+	if (m_pc_log)
+	{
+		fclose(m_pc_log);
+		m_pc_log = nullptr;
+	}
+	if (m_irq_log)
+	{
+		fprintf(m_irq_log, "end %llu\n", (unsigned long long)m_insn_count);
+		fclose(m_irq_log);
+		m_irq_log = nullptr;
+	}
+	// daytona-arcade-recomp: write the indirect-transfer harvest.
+	// One line per unique (kind, source, target): kind source target count.
+	// For irq, source is the interrupt vector; for icr (synmov to the
+	// interrupt control register), target is the new ICR value; for irqat,
+	// source is the IP the interrupt was taken at and target the vector.
+	if (!m_branch_log_on)
+		return;
+	const char *path = getenv("M2TRACE_BRANCHES");
+	FILE *f = fopen(path, "w");
+	if (!f)
+		return;
+	static const char *const kinds[] = { "bx", "balx", "callx", "calls", "irq", "icr", "irqat" };
+	for (const auto &[key, count] : m_branch_log)
+		fprintf(f, "%s %08x %08x %llu\n", kinds[std::get<0>(key)], std::get<1>(key), std::get<2>(key),
+				(unsigned long long)count);
+	fclose(f);
+}
