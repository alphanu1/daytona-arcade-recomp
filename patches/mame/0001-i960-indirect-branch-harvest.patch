+void i960_cpu_device::device_stop()
+{
+	// daytona-arcade-recomp: write the indirect-transfer harvest.
+	// One line per unique (kind, source, target): kind source target count.
+	// For irq, source is the interrupt vector.
+	if (!m_branch_log_on)
+		return;
+	const char *path = getenv("M2TRACE_BRANCHES");
+	FILE *f = fopen(path, "w");
+	if (!f)
+		return;
+	static const char *const kinds[] = { "bx", "balx", "callx", "calls", "irq" };
+	for (const auto &[key, count] : m_branch_log)
+		fprintf(f, "%s %08x %08x %llu\n", kinds[std::get<0>(key)], std::get<1>(key), std::get<2>(key),
+				(unsigned long long)count);
+	fclose(f);
+}
