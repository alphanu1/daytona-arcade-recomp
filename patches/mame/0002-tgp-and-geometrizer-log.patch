+//   in V            TGP popped V from the input FIFO
+//   out V           TGP pushed V to the output FIFO
+//   bank V          TGP wrote its bank register
+//   mr A V          TGP read banked external memory (A = io offset)
+//   mw A V M        TGP wrote banked external memory (M = mem_mask)
+FILE *m2_geo_log()
+{
+	static FILE *f = nullptr;
+	static bool tried = false;
+	if (!tried) {
+		tried = true;
+		if (const char *p = getenv("M2TRACE_GEOLOG"))
+			f = fopen(p, "w");
+	}
+	return f;
+}
