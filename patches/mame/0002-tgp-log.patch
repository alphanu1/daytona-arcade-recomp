+// daytona-arcade-recomp: TGP-side log for the static recompiler's oracle.
+// $M2TRACE_TGPLOG gets one line per TGP-visible event, in order:
+//   up N w0 w1 ...  program uploaded (N words, hex), TGP boots
+//   in V            TGP popped V from the input FIFO
+//   out V           TGP pushed V to the output FIFO
+//   bank V          TGP wrote its bank register
+//   mr A V          TGP read banked external memory (A = io offset)
+//   mw A V M        TGP wrote banked external memory (M = mem_mask)
+static FILE *m2_tgp_log()
+{
+	static FILE *f = nullptr;
+	static bool tried = false;
+	if (!tried) {
+		tried = true;
+		if (const char *p = getenv("M2TRACE_TGPLOG"))
+			f = fopen(p, "w");
+	}
+	return f;
+}
